# Copy to .env locally, fill in your server values, then: set -a; . ./.env; set +a
# This file is shell syntax; quote values, especially passwords containing punctuation.
CHARACTER_HUB_DB_MODE=direct
CHARACTER_HUB_DB_HOST=127.0.0.1
CHARACTER_HUB_DB_PORT=3306
CHARACTER_HUB_DB_USER=character_hub
CHARACTER_HUB_DB_PASSWORD='REPLACE_WITH_YOUR_PASSWORD'
CHARACTER_HUB_CHARACTERS_SCHEMA=acore_characters
CHARACTER_HUB_WORLD_SCHEMA=acore_world
CHARACTER_HUB_AUTH_SCHEMA=acore_auth
# Native setup reads the local extracted server data/dbc directory.
CHARACTER_HUB_DBC_PATH=/home/YOUR_USER/azerothcore/data/dbc
# Optional mixed setup: use container DBCs with a direct MySQL connection.
# CHARACTER_HUB_DBC_SOURCE=docker
# CHARACTER_HUB_DBC_PATH=/azerothcore/env/dist/data/dbc
# Optional Docker metadata preparation:
CHARACTER_HUB_DB_CONTAINER=YOUR_DATABASE_CONTAINER
CHARACTER_HUB_WORLD_CONTAINER=YOUR_WORLDSERVER_CONTAINER
# Optional realm selection and friendly dashboard host label:
CHARACTER_HUB_REALM_ID=1
CHARACTER_HUB_HOST_NAME='My Character Hub'
