# Copy to .env locally, fill in your server values, then: set -a; . ./.env; set +a
# This file is shell syntax; quote values, especially passwords containing punctuation.
JOURNEY_HUB_DB_MODE=direct
JOURNEY_HUB_DB_HOST=127.0.0.1
JOURNEY_HUB_DB_PORT=3306
JOURNEY_HUB_DB_USER=journey_hub
JOURNEY_HUB_DB_PASSWORD='REPLACE_WITH_YOUR_PASSWORD'
JOURNEY_HUB_CHARACTERS_SCHEMA=acore_characters
JOURNEY_HUB_WORLD_SCHEMA=acore_world
JOURNEY_HUB_AUTH_SCHEMA=acore_auth
# Native setup reads the local extracted server data/dbc directory.
JOURNEY_HUB_DBC_PATH=/home/YOUR_USER/azerothcore/data/dbc
# Optional mixed setup: use container DBCs with a direct MySQL connection.
# JOURNEY_HUB_DBC_SOURCE=docker
# JOURNEY_HUB_DBC_PATH=/azerothcore/env/dist/data/dbc
# Optional Docker metadata preparation:
JOURNEY_HUB_DB_CONTAINER=YOUR_DATABASE_CONTAINER
JOURNEY_HUB_WORLD_CONTAINER=YOUR_WORLDSERVER_CONTAINER
# Optional realm selection and friendly dashboard host label:
JOURNEY_HUB_REALM_ID=1
JOURNEY_HUB_HOST_NAME='My Journey Hub'
